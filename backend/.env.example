# Add these to your backend .env when using Vercel + ngrok

# Your Vercel frontend URL (set after first deploy)
FRONTEND_URL=https://your-app.vercel.app

# Your ngrok backend URL
BACKEND_URL=https://cinema-rocklike-unhappily.ngrok-free.dev

# Optional: restrict CORS to your Vercel domain (comma-separated)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
